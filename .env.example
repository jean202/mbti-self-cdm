# ─── 서버 ───────────────────────────────────────────────────────────
PORT=3000
# 컨테이너/Railway 환경: 0.0.0.0 (기본값)
# 로컬 개발 시에는 127.0.0.1 로 재정의
HOST=0.0.0.0
API_BASE_URL=https://your-app.railway.app

# ─── CORS ────────────────────────────────────────────────────────────
# 쉼표 구분 (예: https://app.example.com,https://staging.example.com)
CORS_ORIGINS=http://localhost:3000

# ─── 데이터베이스 ───────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://HOST:6379

# ─── 보안 ────────────────────────────────────────────────────────────
# 32바이트 이상 랜덤 문자열: openssl rand -base64 32
ENCRYPTION_KEY=change-me-with-openssl-rand-base64-32

# 비워두면 개발용 기본값이 쓰인다. 운영(NODE_ENV=production)에서는 비우거나 기본값/자리표시자를
# 그대로 두면 서버가 기동하지 않는다.
AUTH_ACCESS_TOKEN_SECRET=change-me-with-openssl-rand-base64-32
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# ─── 소셜 로그인 ─────────────────────────────────────────────────────
# provider_user_id만으로 로그인하는 개발용 우회 경로. 비워두면 로컬/테스트에서는 켜지고
# 운영(NODE_ENV=production)에서는 꺼진다. 운영에서는 true로 두지 않는다(켜면 기동 시 경고).
AUTH_ENABLE_DEV_IDENTITY_BRIDGE=
# id_token의 aud로 허용할 클라이언트 ID. 쉼표로 여러 개(iOS/Android/Web). 비우면 그 provider의
# id_token 로그인은 503 SOCIAL_PROVIDER_NOT_CONFIGURED가 된다.
AUTH_GOOGLE_CLIENT_IDS=
AUTH_APPLE_CLIENT_IDS=
AUTH_KAKAO_CLIENT_IDS=92b0396972c5416f5bd2b7e8b0815e61
AUTH_NAVER_CLIENT_IDS=
# 아직 코드에서 읽지 않는다. authorization_code 교환을 구현할 때 쓸 자리다.
KAKAO_REST_API_KEY=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── 캘린더 OAuth ────────────────────────────────────────────────────
# CALENDAR_GOOGLE_* 가 비어 있으면 GOOGLE_OAUTH_* 를 대신 쓴다.
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_GOOGLE_CALLBACK_URI=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 연결 완료 후 돌려보낼 수 있는 앱 주소(쉼표 구분, 스킴+호스트+경로 접두어로 비교).
# 비우면 http/https 등 웹 주소는 거부하고 앱 스킴(myapp://...)만 받는다.
CALENDAR_OAUTH_ALLOWED_REDIRECT_URIS=
# 로컬 개발 전용 브리지 (프로덕션에서는 false)
CALENDAR_ENABLE_DEV_OAUTH_BRIDGE=false

# ─── YouTube 영상 추천 (선택) ────────────────────────────────────────
# 비워두면 type profile의 큐레이션 영상 또는 YouTube 검색 링크만 내려준다
YOUTUBE_API_KEY=
